# ========================================================
# vCraft Environment Variables (development defaults)
# ========================================================

# Database (PostgreSQL 17)
POSTGRES_DB=vcraft_db
POSTGRES_USER=vcraft_user
POSTGRES_PASSWORD=vcraft_secret_2026
POSTGRES_PORT=5433

# Prisma Database Connection URL
DATABASE_URL="postgresql://vcraft_user:vcraft_secret_2026@localhost:5433/vcraft_db?schema=public"

# Backend Application
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars

# Storage (SEC-10)
UPLOAD_DIR=./storage/uploads
